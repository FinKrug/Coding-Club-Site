{
  "name": "coding-club-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build-resources-zip": "node scripts/build-local-dev-tools-zip.js",
    "dev": "npm run build-resources-zip && next dev",
    "build": "npm run build-resources-zip && next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "npm run build-resources-zip && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run build-resources-zip && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@monaco-editor/react": "^4.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "wrangler": "^4.129.0"
  }
}
