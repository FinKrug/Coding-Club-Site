{
  "name": "coding-club-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build-resources-zip": "node scripts/build-local-dev-tools-zip.js",
    "dev": "npm run build-resources-zip && next dev",
    "build": "npm run build-resources-zip && next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "npm run build-resources-zip && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run build-resources-zip && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-challenges.mjs",
    "db:check": "node --env-file=.env.local scripts/check-challenges.mjs",
    "judge:selftest": "node --env-file=.env.local scripts/judge-selftest.mjs",
    "points:recalc": "node --env-file=.env.local scripts/recalc-points.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "wrangler": "^4.129.0"
  }
}
