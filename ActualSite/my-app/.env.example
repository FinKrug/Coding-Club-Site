# Copy this file to .env.local and fill in the values (.env.local is
# git-ignored; never commit real secrets). See the README's
# "Accounts & Database" section for where each value comes from.

# --- Code runner ---
JUDGE0_URL=https://judge0.neumontcoding.club
JUDGE0_AUTH_TOKEN=

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=coding-club

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: comma-separated email domains allowed to sign in with Google.
# Leave empty (Neumont school emails aren't Google accounts).
ALLOWED_EMAIL_DOMAINS=

# Set to false to hide "Continue with Google" (email + password only).
GOOGLE_SIGNIN_ENABLED=true

# --- Email + password sign-in ---
# Random string, 32+ characters, mixed into every password before hashing.
# NEVER change or lose it: every password would stop working.
# Generate with the same command as SESSION_SECRET.
PASSWORD_PEPPER=

# Resend API key (resend.com -> API Keys). Leave empty in development and
# the sign-up / reset codes are printed in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Neumont Coding Club <noreply@neumontcoding.club>
