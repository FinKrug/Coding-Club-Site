{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coding-club-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "JUDGE0_URL": "https://judge0.neumontcoding.club",
    // Sender for sign-up / password-reset code emails (domain verified in Resend)
    "EMAIL_FROM": "Neumont Coding Club <noreply@neumontcoding.club>",
    // "Continue with Google" is off until the Google app is published
    "GOOGLE_SIGNIN_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  }
}
